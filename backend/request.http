@api = http://localhost:5000/api

### 1. Probar que el servidor responde
GET {{api}}/health

### ==========================================
### USUARIOS (AUTH)
### ==========================================

### Registrar Dueño (Ejecutar una sola vez)
POST {{api}}/usuarios/registro
Content-Type: application/json

{
  "nombre": "Eligio",
  "email": "eligioarena@admin.com",
  "password": "25218379"
}

### Login Dueño (Guarda el token que te devuelve)
POST {{api}}/usuarios/login
Content-Type: application/json

{
  "email": "eligioarena@admin.com",
  "password": "25218379"
}

### ==========================================
### PRODUCTOS (PIRULÍN)
### ==========================================

### Obtener todos los productos
GET {{api}}/productos

### Crear producto con imagen en Cloudinary
POST {{api}}/productos
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="nombre"

Pirulín Lata Grande
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="precio"

3.50
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="stock"

50
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="imagen"; filename="pagobdv1.jpeg"
Content-Type: image/jpeg

< ./uploads/lata_grande.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### ==========================================
### PRUEBAS DE PRODUCTOS (Actualizar)
### ==========================================

### Actualizar producto (Puedes enviar nuevos datos y/o nueva imagen con Multipart)
PUT {{api}}/productos/6af837106106ad4012d1d166
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="nombre"

Pirulín Premium Actualizado
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="precio"

4.00
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="stock"

30
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Eliminar producto (reemplaza el ID por uno real de tu BD)
DELETE {{api}}/productos/6af837106106ad4012d1d166


### ==========================================
### CLIENTES
### ==========================================

### Obtener todos los clientes
GET {{api}}/clientes

### Crear un cliente (con teléfono incluido)
POST {{api}}/clientes
Content-Type: application/json

{
  "nombre": "María Pérez",
  "departamento": "Contabilidad",
  "telefono": "+584121234567"
}

### ==========================================
### PRUEBAS DE CLIENTES (Actualizar y Eliminar)
### ==========================================

### Actualizar un cliente (Reemplaza el ID por uno real de tu base de datos)
PUT {{api}}/clientes/6af76b2516a94a9211788b8b
Content-Type: application/json

{
  "nombre": "Cliente Actualizado",
  "departamento": "Ventas",
  "telefono": "0412-1234567"
}

### Eliminar cliente (reemplaza el ID)
DELETE {{api}}/clientes/6af7667823fdfa06f331fb11

### ==========================================
### ENTREGAS Y PAGOS
### ==========================================

### Obtener todas las entregas / deudas (incluye datos del cliente con su teléfono)
GET {{api}}/entregas

### Registrar nueva entrega (ej. fiado)
POST {{api}}/entregas
Content-Type: application/json

{
  "cliente": "6af76b2516a94a9211788b8b",
  "producto": "6af7616df085be9d91ed93f4",
  "cantidad": 2,
  "montoTotal": 7.00,
  "estadoPago": "pendiente",
  "metodoPago": "por_definir",
  "referenciaPago": ""
}

### Actualizar datos generales de una entrega (Reemplaza el ID por uno real)
PUT {{api}}/entregas/6af76cfa1a2c3f2386b724fa
Content-Type: application/json

{
  "cantidad": 5,
  "montoTotal": 17.50,
  "estadoPago": "pendiente"
}

### Actualizar pago (cuando envían el capture de pago móvil)
PUT {{api}}/entregas/6af76cfa1a2c3f2386b724fa/pago
Content-Type: application/json

{
  "estadoPago": "pagado",
  "metodoPago": "pago_movil",
  "referenciaPago": "4321"
}

### Eliminar entrega
DELETE {{api}}/entregas/6af76c961a2c3f2386b724f9

### Actualizar pago con comprobante de imagen (Multipart)
PUT {{api}}/entregas/6af76cfa1a2c3f2386b724fa/pago
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="estadoPago"

pagado
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="metodoPago"

pago_movil
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="referenciaPago"

123456
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="comprobante"; filename="capture_prueba.jpg"
Content-Type: image/jpeg

< ./backend/uploads/pagobdv1.jpeg
------WebKitFormBoundary7MA4YWxkTrZu0gW--